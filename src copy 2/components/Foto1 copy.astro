---
// src/components/Foto1.astro
// Foto a todo el ancho en blanco y negro, cortada abajo como papel
// rasgado. Debajo asoma una tira color crema —también rasgada— y encima
// de las dos, cruzando el corte, la guirnalda con los nombres.
//
// Medidas sacadas del diseño, en % del ancho de la columna:
//   foto      61%  de alto (es el alto natural de foto1.webp, 1500x920)
//   crema     28.9% de alto, asomando debajo del rasgado
//   guirnalda 41% de ancho, centrada, arrancando al 69.4%
//
// Los dos rasgados son clip-path: el de la foto deja ver la crema y el de
// la tira deja ver el papel de la página.

// ── DATOS EDITABLES ───────────────────────────────────────────
const foto = "/imagenes/foto1.webp";
const alt = "Sebastián y Adriana festejando con una botella de champán";
const novio = "Sebastian";
const novia = "Adriana";
// ──────────────────────────────────────────────────────────────
---

<section id="foto-rasgada" class="seccion">
    <!-- La tira crema: la foto va adentro y el rasgado de abajo la corta -->
    <div id="foto-tira" class="tira">
        <img
            id="foto-rasgada-img"
            src={foto}
            alt={alt}
            width="1500"
            height="920"
            class="foto"
        />
    </div>

    <!-- La guirnalda cruza el corte, mitad sobre la crema, mitad afuera -->
    <div id="foto-guirnalda" class="guirnalda-caja">
        <img
            src="/imagenes/guirnalda2.png"
            alt=""
            aria-hidden="true"
            class="guirnalda"
        />

        <div id="foto-nombres" class="nombres">
            <p class="nombre font-elegant">{novio}</p>
            <p class="amper font-elegant">&amp;</p>
            <p class="nombre font-elegant">{novia}</p>
        </div>
    </div>
</section>

<style>
    /*
       Sección a sangre: la foto tiene que llegar a los dos bordes de la
       columna, así que acá no va padding lateral. El de abajo es para la
       guirnalda, que se sale de la tira crema.
    */
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 26%;
    }

    /*
       La tira crema. Los dos rasgados no son un zigzag inventado: son el
       contorno del diseño leído píxel por píxel, columna por columna, y
       pasado a puntos de clip-path. Por eso el filo es irregular de
       verdad, con tramos largos y muescas sueltas, como el papel roto.
    */
    .tira {
        position: relative;
        width: 100%;
        background: #eee9cb;
        /* El alto es el de la foto (61.3%) más lo que asoma la crema (28.9%) */
        padding-bottom: 28.9%;
        clip-path: polygon(
            0 0,
            100% 0,
            98.9% 98.3%,
            97.9% 98.1%,
            96.8% 97.6%,
            95.7% 96.7%,
            94.7% 96%,
            93.6% 95.8%,
            91.5% 96%,
            90.4% 95.5%,
            89.4% 95.8%,
            88.3% 96.2%,
            87.2% 97.2%,
            86.2% 97.4%,
            85.1% 97.6%,
            84% 97.9%,
            83% 98.1%,
            81.9% 98.1%,
            80.9% 97.6%,
            79.8% 97.4%,
            78.7% 96.9%,
            77.7% 97.4%,
            76.6% 97.6%,
            74.5% 98.3%,
            73.4% 98.6%,
            72.3% 98.8%,
            71.3% 99.1%,
            70.2% 98.2%,
            69.1% 98.3%,
            68.1% 98.6%,
            67% 99%,
            66% 99.6%,
            64.9% 100%,
            63.8% 100%,
            62.8% 100%,
            61.7% 100%,
            60.6% 100%,
            59.6% 100%,
            58.5% 100%,
            57.4% 99.6%,
            56.4% 99.1%,
            55.3% 98.8%,
            54.3% 98.6%,
            53.2% 98.6%,
            52.1% 98.7%,
            51.1% 98.8%,
            50% 98.8%,
            48.9% 98.7%,
            47.9% 98.5%,
            46.8% 98.3%,
            45.7% 98%,
            44.7% 98%,
            43.6% 98.1%,
            42.6% 98.5%,
            41.5% 99%,
            40.4% 99.7%,
            39.4% 100%,
            38.3% 100%,
            37.2% 100%,
            36.2% 100%,
            35.1% 100%,
            34% 100%,
            33% 100%,
            31.9% 100%,
            30.9% 100%,
            29.8% 99.8%,
            28.7% 99.7%,
            27.7% 99.8%,
            26.6% 98.3%,
            25.5% 98.3%,
