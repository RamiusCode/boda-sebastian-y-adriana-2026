            33% 97.2%,
            31.9% 96.9%,
            30.9% 97.2%,
            26.6% 96.5%,
            24.5% 96.9%,
            22.3% 96.9%,
            21.3% 95.8%,
            20.2% 95.1%,
            19.1% 94.1%,
            17% 93.8%,
            16% 93.8%,
            14.9% 92.7%,
            12.8% 95.1%,
            11.7% 95.1%,
            10.6% 95.5%,
            9.6% 95.1%,
            7.4% 95.8%,
            6.4% 96.2%,
            5.3% 96.2%,
            4.3% 95.8%,
            1.1% 96.5%,
            0 96.5%
        );
    }

    /*
       La guirnalda: centrada y arrancando al 69.4% del ancho contado desde
       el borde de arriba de la tira, que es donde cae en el diseño. Lleva
       container-type para que los nombres se midan contra ella.
    */
    .guirnalda-caja {
        position: absolute;
        left: 50%;
        margin-left: -20.5%;
        top: 69.4%;
        width: 41%;
        container-type: inline-size;
    }

    .guirnalda {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
    }

    /* ── Nombres, en el centro de la guirnalda ─────────────── */
    .nombres {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .nombre {
        color: #3d300d;
        font-size: 15cqw;
        line-height: 1.05;
    }

    /* Más chico y corrido a la derecha, como en el diseño */
    .amper {
        color: #3d300d;
        font-size: 9cqw;
        line-height: 1;
        margin: -0.1em 0 -0.1em 1.7em;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const tira = document.getElementById("foto-tira");
        const foto = document.getElementById("foto-rasgada-img");
        const guirnalda = document.getElementById("foto-guirnalda");
        if (!tira || !foto) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const disparador = {
            trigger: tira,
            start: "top 85%",
            toggleActions: "play none none reset",
        };

        // La foto arranca ampliada y se va acomodando: un respiro, no un
        // efecto. El clip-path de la tira contiene el zoom.
        gsap.fromTo(
            foto,
            { scale: 1.18 },
            {
                scale: 1,
                duration: 2.4,
                ease: "power2.out",
                scrollTrigger: disparador,
            },
        );

        gsap.fromTo(
            tira,
            { opacity: 0 },
            {
                opacity: 1,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: disparador,
            },
        );

        if (guirnalda) {
            const nombres = Array.from(
                guirnalda.querySelectorAll("#foto-nombres > *"),
            );

            gsap.fromTo(
                guirnalda.querySelector(".guirnalda"),
                { opacity: 0, scale: 0.88 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 1.2,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: disparador,
                },
            );

            gsap.fromTo(
                nombres,
                { opacity: 0, y: 14 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    delay: 0.8,
                    stagger: 0.18,
                    ease: "power2.out",
                    scrollTrigger: disparador,
                },
            );
        }
    });
</script>
