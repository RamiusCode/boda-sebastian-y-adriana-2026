            3.2% 99.5%,
            2.1% 99.5%,
            1.1% 99.1%,
            0 99.1%
        );
    }

    /*
       La foto: blanco y negro como en el diseño, y con su propio rasgado
       abajo para que la crema asome por el corte.
    */
    .foto {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(1) contrast(1.06);
        clip-path: polygon(
            0 0,
            100% 0,
            97.9% 100%,
            95.7% 99.7%,
            92.6% 97.6%,
            91.5% 96.9%,
            90.4% 96.2%,
            88.3% 95.1%,
            87.2% 94.1%,
            86.2% 94.1%,
            84% 94.1%,
            83% 95.5%,
            81.9% 95.5%,
            79.8% 96.9%,
            78.7% 97.6%,
            77.7% 97.2%,
            76.6% 97.2%,
            75.5% 96.2%,
            74.5% 96.2%,
            73.4% 96.5%,
            72.3% 96.5%,
            71.3% 96.5%,
            70.2% 96.9%,
            69.1% 98.3%,
            68.1% 97.6%,
            67% 97.6%,
            66% 97.6%,
            64.9% 96.5%,
            63.8% 96.9%,
            62.8% 96.2%,
            61.7% 95.1%,
            60.6% 94.8%,
            59.6% 94.4%,
            58.5% 96.2%,
            57.4% 95.8%,
