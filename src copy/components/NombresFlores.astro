---
// src/components/NombresFlores.astro
// Sobre abierto: el perrito sale desde adentro y queda con la parte de
// abajo metida detrás de la solapa, y las flores se apoyan encima de esa
// solapa.
//
// Referencias de medida (todo en % del ancho del sobre):
//   sobre1 930x1167  ·  sobre2 930x711 (va al pie)
//   El pico de la solapa queda al 63.9% de la altura: esa es la línea
//   donde el perrito se esconde.
---

<!--
   Padding parejo: ahora abajo sigue la Dedicatoria, que es una sección
   normal. La compensación del -mt-28 del Versículo pasó a esa, que es la
   que quedó justo antes.
-->
<section
    id="sobre-novios"
    class="relative w-full flex items-center justify-center px-4 py-14 sm:py-20 md:py-24"
>
    <div id="sobre-marco" class="sobre-marco">
        <!-- CAPA 1 · sobre trasero (base abierta) -->
        <img
            id="sobre-atras"
            src="/imagenes/sobre1.png"
            alt=""
            aria-hidden="true"
            class="block w-full h-auto select-none"
        />

        <!-- CAPA 2 · el perrito, que sale desde adentro del sobre -->
        <div id="sobre-interior" class="capa-interior">
            <img
                id="sobre-perrito"
                src="/imagenes/perrito.png"
                alt="Lu, el perrito de los novios"
                class="deco perrito"
            />
        </div>

        <!-- CAPA 3 · solapa delantera: le tapa las patas al perrito -->
        <img
            id="sobre-frente"
            src="/imagenes/sobre2.png"
            alt=""
            aria-hidden="true"
            class="capa-frente"
        />

        <!--
           CAPA 4 · las flores, DETRÁS de la solapa y del perrito (el CSS
           les da z-index 1). Van acá abajo en el orden del documento nada
           más que para tenerlas juntas.
           Cada una va envuelta en un <span>: GSAP le anima el transform al
           span, y el espejo y la inclinación viven en la imagen de adentro
           para que no se pisen entre sí.
        -->
        <div class="capa-flores">
            <span class="deco flor flor-izq">
                <img src="/imagenes/flores2.png" alt="" aria-hidden="true" />
            </span>
            <span class="deco flor flor-der">
                <img src="/imagenes/flores2.png" alt="" aria-hidden="true" />
            </span>
            <span class="deco flor flor-baja-izq">
                <img src="/imagenes/flores2.png" alt="" aria-hidden="true" />
            </span>
            <span class="deco flor flor-baja-der">
                <img src="/imagenes/flores2.png" alt="" aria-hidden="true" />
            </span>
        </div>
    </div>
</section>

<style>
    /*
       El papel de acuarela detrás del sobre: el mismo fondo2.png de la
       Dedicatoria. Va en un ::before y no en la sección para poder
       desvanecerle los filos con una máscara sin tocar el sobre.

       El degradado es largo (130px arriba y abajo, contra los 70 de la
       Dedicatoria) para que el papel se disuelva bien de a poco en el
       fondo de la página.
    */
    #sobre-novios::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: url("/imagenes/fondo2.png");
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-position: center;
        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0,
            #000 130px,
            #000 calc(100% - 130px),
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            transparent 0,
            #000 130px,
            #000 calc(100% - 130px),
            transparent 100%
        );
    }

    /*
       container-type deja usar unidades cqw: todas las capas se miden
       contra el ancho del sobre y no del viewport, así el armado no se
       descuadra en ningún tamaño de pantalla.
    */
    .sobre-marco {
        position: relative;
        /* Por encima del ::before del papel */
        z-index: 1;
        width: 100%;
        max-width: 26rem;
        container-type: inline-size;
        filter: drop-shadow(0 18px 34px rgba(120, 58, 32, 0.22));
    }

    /* Todo lo que va detrás de la solapa */
    .capa-interior {
        position: absolute;
        inset: 0;
        z-index: 2;
    }

    .capa-frente {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: auto;
        z-index: 3;
    }

    .deco {
        position: absolute;
        height: auto;
        user-select: none;
        pointer-events: none;
    }

    /*
       El perrito: se centra con margin negativo (la mitad de su ancho) y
       no con translateX, porque GSAP le anima el transform para que flote.
       Con width 48% mide 39% de la altura del sobre; arrancando en 36.5%
       llega hasta el 75.5%, la misma línea de antes, así que sigue con el
       mismo pedazo escondido detrás de la solapa (que empieza en 63.9%).
    */
    .perrito {
        left: 50%;
        margin-left: -24%;
        top: 36.5%;
        width: 48%;
        filter: drop-shadow(0 8px 16px rgba(120, 58, 32, 0.2));
    }

    /*
       ── Flores: DETRÁS de la solapa (sobre2) ──
       z-index 1 las deja arriba de sobre1 pero abajo del perrito (2) y de
       la solapa (3): salen del interior del sobre y la solapa les corta la
       parte de abajo, igual que al perrito.

       El clip-path calca la silueta de sobre1: el pico arriba al centro y
       las dos alas que bajan hasta el 40% de la altura (465 de 1167 px).
       Sigue haciendo falta: a la altura del 24% el filo del ala está recién
       en el 20% del ancho, así que sin recorte se salen del sobre.
    */
    .capa-flores {
        position: absolute;
        inset: 0;
        z-index: 1;
        clip-path: polygon(50% 0, 100% 40%, 100% 100%, 0 100%, 0 40%);
    }

    .flor {
        display: block;
    }

    .flor :global(img) {
        display: block;
        width: 100%;
        height: auto;
    }

    /*
       El espejo y la inclinación quedan en la imagen de adentro (el <span>
       de afuera lo maneja GSAP), así que cada flor declara su transform
       completo.
       Las cuatro van dentro del rombo blanco, flanqueando al perrito: la
       solapa les come la parte de abajo y él les pasa por delante.
    */
    .flor-izq {
        left: 1%;
        top: 24%;
        width: 30%;
    }

    .flor-izq :global(img) {
        transform: scaleX(-1) rotate(4deg);
    }

    .flor-der {
        left: 69%;
        top: 26%;
        width: 30%;
    }

    .flor-der :global(img) {
        transform: rotate(-4deg);
    }

    /* El segundo par va más chico y corrido, para dar volumen al ramo */
    .flor-baja-izq {
        left: 7%;
        top: 34%;
        width: 20%;
    }

    .flor-baja-izq :global(img) {
        transform: scaleX(-1) rotate(-7deg);
    }

    .flor-baja-der {
        left: 73%;
        top: 36%;
        width: 20%;
    }

    .flor-baja-der :global(img) {
        transform: rotate(7deg);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const marco = document.getElementById("sobre-marco");
        if (!marco) return;

        // Sin animación si el visitante pidió menos movimiento: el sobre
        // ya está armado y visible en el HTML.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const interior = document.getElementById("sobre-interior");
        const perrito = document.getElementById("sobre-perrito");
        const flores = Array.from(marco.querySelectorAll(".flor"));

        // El perrito arranca escondido dentro del sobre: la solapa
        // delantera lo tapa mientras sube.
        gsap.set(interior, { yPercent: 26, opacity: 0 });
        // Ahora que están detrás de la solapa, salen del sobre en vez de
        // aparecer con un escalado.
        gsap.set(flores, { opacity: 0, yPercent: 30 });

        /*
           Arranca pausada. Quién la larga depende de si hay portada:

           · Con portada, la larga el botón de ingreso. Un ScrollTrigger no
             sirve acá: esta es la primera sección, así que ya está "a la
             vista" en la carga aunque la portada la tape, y la entrada se
             consumiría sola mientras el invitado todavía mira el sello.

           · Sin portada, se comporta como el resto de las secciones y la
             larga el scroll.
        */
        const linea = gsap.timeline({ paused: true });

        linea
            // 1 · el sobre se asienta
            .fromTo(
                "#sobre-atras",
                { opacity: 0, scale: 0.94, y: 18 },
                { opacity: 1, scale: 1, y: 0, duration: 1, ease: "power2.out" },
            )
            .fromTo(
                "#sobre-frente",
                { opacity: 0, y: 14 },
                { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                "<0.15",
            )
            // 2 · el perrito sale de adentro
            .to(
                interior,
                { yPercent: 0, opacity: 1, duration: 1.7, ease: "power3.out" },
                "-=0.4",
            )
            // 3 · las flores salen del sobre, atrás del perrito
            .to(
                flores,
                {
                    opacity: 1,
                    yPercent: 0,
                    duration: 1.4,
                    stagger: 0.12,
                    ease: "power3.out",
                },
                "-=1.5",
            )
            // 4 · el perrito queda flotando apenas
            .add(() => {
                gsap.to(perrito, {
                    y: -6,
                    duration: 3.2,
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                });
            });

        // ═══ QUIÉN LARGA LA ENTRADA ═══
        function arrancar() {
            /*
               La portada tenía el scroll bloqueado y ocupaba la pantalla,
               así que las medidas que ScrollTrigger calculó en la carga ya
               no valen. El refresh las rehace antes de reproducir.
            */
            ScrollTrigger.refresh();
            linea.restart();
        }

        const portada = document.getElementById("portada-section");

        if ((window as any).portadaAbierta) {
            // Su script corrió antes que este y ya avisó
            arrancar();
        } else if (portada) {
            window.addEventListener("portada-abierta", arrancar, {
                once: true,
            });
        } else {
            // Sin portada: entra con el scroll, como las demás secciones
            ScrollTrigger.create({
                trigger: marco,
                start: "top 78%",
                onEnter: () => linea.restart(),
                onLeaveBack: () => linea.pause(0),
            });
        }
    });
</script>
