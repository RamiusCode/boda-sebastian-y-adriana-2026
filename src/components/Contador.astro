            54.55% 93.51%,
            52.73% 93.54%,
            50.91% 94.00%,
            49.09% 95.11%,
            47.27% 94.44%,
            45.45% 93.84%,
            43.64% 94.02%,
            41.82% 93.49%,
            40.00% 95.75%,
            38.18% 96.00%,
            36.36% 95.85%,
