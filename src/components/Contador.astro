            0.00% 98.37%
        );
    }

    /* Mismo tamaño y color que el título de la Fecha */
    .titulo {
        margin: 0 auto;
        max-width: 20rem;
        text-align: center;
        color: #643e1a;
        font-size: clamp(2.35rem, 10.7vw, 2.9rem);
        line-height: 1.2;
    }

    /* ── La cuenta regresiva ───────────────────────────────── */
    .casillas {
        display: flex;
        justify-content: center;
        gap: 3.3%;
        width: 100%;
        max-width: 23rem;
        margin: 0 auto;
        padding: 3rem 1.2rem 0;
    }

    /*
       min-width 0: sin esto el rótulo más largo ("Segundos") ensancha su
       columna y los cuatro arcos dejan de medir igual.
    */
    .casilla {
        flex: 1;
        min-width: 0;
        text-align: center;
    }

    /* El arco: medio punto arriba y las esquinas de abajo apenas suaves */
    .arco {
        width: 100%;
        aspect-ratio: 70 / 83;
        background: #6b4e14;
        border-radius: 999px 999px 6px 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        /* El número se mide contra el ancho del arco */
        container-type: inline-size;
    }

    .numero {
        color: #e6e1d8;
        font-size: 46cqw;
        line-height: 1;
    }

    .rotulo {
        margin-top: 0.5rem;
        color: #643e1a;
        font-size: clamp(1rem, 4.5vw, 1.2rem);
        line-height: 1.2;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const caja = document.getElementById("contador");
        const banda = document.getElementById("banda-contador");
        if (!caja) return;

        // ── La cuenta ───────────────────────────────────────────
        const destino = new Date(caja.dataset.fecha ?? "").getTime();
        const campo = (n: string) =>
            caja.querySelector<HTMLElement>(`[data-campo="${n}"]`);
        const dias = campo("dias");
        const horas = campo("horas");
        const minutos = campo("minutos");
        const segundos = campo("segundos");

        const dosDigitos = (n: number) => n.toString().padStart(2, "0");

        const refrescar = () => {
            const falta = destino - Date.now();

            if (!isFinite(destino)) return;

            // Ya pasó la fecha: todo en cero, y no hace falta seguir
            if (falta <= 0) {
                if (dias) dias.textContent = "00";
                if (horas) horas.textContent = "00";
                if (minutos) minutos.textContent = "00";
                if (segundos) segundos.textContent = "00";
                clearInterval(reloj);
                return;
            }

            const s = Math.floor(falta / 1000);
            if (dias) dias.textContent = dosDigitos(Math.floor(s / 86400));
            if (horas) horas.textContent = dosDigitos(Math.floor(s / 3600) % 24);
            if (minutos) minutos.textContent = dosDigitos(Math.floor(s / 60) % 60);
            if (segundos) segundos.textContent = dosDigitos(s % 60);
        };

        refrescar();
        const reloj = setInterval(refrescar, 1000);

        // ── Entrada ─────────────────────────────────────────────
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           Las flores entran creciendo desde chiquitas hasta su tamaño y
           después quedan meciéndose despacio, como si estuvieran vivas.

           Se anima la CAJA y no la imagen: la imagen lleva el scaleY(-1)
           y GSAP lee ese menos como media vuelta, así que si la animara a
           ella el ramo giraría como un trompo.
        */
        const flores = document.querySelector<HTMLElement>(
            "#contador-boda .caja-flores",
        );
        if (flores) {
            gsap.fromTo(
                flores,
                { scale: 0.45, x: -70, opacity: 0 },
                {
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    duration: 1.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: flores,
                        start: "top 95%",
                        toggleActions: "play none none reset",
                    },
                    onComplete: () => {
                        gsap.to(flores, {
                            rotation: 1.6,
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );
        }

        if (banda) {
            gsap.fromTo(
                banda.querySelector(".titulo"),
                { opacity: 0, y: 16 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: banda,
                        start: "top 85%",
                        toggleActions: "play none none reset",
                    },
                },
            );
        }

        gsap.fromTo(
            caja.children,
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.12,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: caja,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
