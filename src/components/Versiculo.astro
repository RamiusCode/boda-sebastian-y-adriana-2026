            70.91% 3.71%,
            72.73% 5.69%,
            74.55% 7.05%,
            76.36% 4.33%,
            78.18% 6.36%,
            80.00% 6.49%,
            81.82% 6.46%,
            83.64% 6.00%,
            85.45% 4.89%,
            87.27% 5.56%,
            89.09% 6.16%,
            90.91% 5.98%,
            92.73% 6.51%,
            94.55% 4.25%,
            96.36% 4.00%,
            98.18% 4.15%,
            100.00% 8.50%,
            100.00% 94.36%,
            98.18% 95.05%,
            96.36% 94.00%,
            94.55% 96.16%,
            92.73% 94.21%,
            90.91% 93.35%,
            89.09% 95.86%,
            87.27% 97.63%,
            85.45% 96.73%,
            83.64% 95.90%,
