    /*
       El texto va en mayúsculas por diseño, no en el dato: así el
       versículo se puede leer y editar normal en el frontmatter.
    */
    .texto {
        margin: 0 auto;
        max-width: 21rem;
        color: #643e1a;
        text-transform: uppercase;
        text-align: center;
        font-size: clamp(1.1rem, 5vw, 1.4rem);
        line-height: 1.6;
        letter-spacing: 0.03em;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-versiculo");
        if (!franja) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const texto = franja.querySelector(".texto");

        gsap.fromTo(
            franja,
            { opacity: 0 },
            {
                opacity: 1,
                duration: 0.9,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: franja,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        gsap.fromTo(
            texto,
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                delay: 0.3,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: franja,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
