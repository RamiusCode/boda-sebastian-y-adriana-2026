    }

    /* Mismo tamaño y color que los otros títulos de la invitación */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(1.8rem, 8.2vw, 2.25rem);
        line-height: 1.2;
    }

    /* ── El cuerpo ─────────────────────────────────────────── */
    .cuerpo {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.4rem 1rem 0;
    }

    .ilustracion {
        display: block;
        width: 34%;
        max-width: 11rem;
        height: auto;
        user-select: none;
    }

    .direccion {
        margin-top: 1.6rem;
        text-align: center;
    }

    /* Mismo tamaño que los renglones de la ceremonia */
    .linea {
        color: #643e1a;
        font-size: clamp(1.45rem, 6.5vw, 1.75rem);
        line-height: 1.75;
    }

    /* ── El botón del mapa ─────────────────────────────────── */
    .boton {
        display: inline-block;
        margin-top: 1.6rem;
        padding: 0.55rem 2.4rem;
        min-width: 32.7%;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #643e1a;
        background: #fbf5de;
        border-radius: 10px;
        font-size: clamp(1.15rem, 5vw, 1.3rem);
        box-shadow: 0 4px 12px rgba(90, 65, 25, 0.12);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .boton:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(90, 65, 25, 0.18);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-recepcion");
        const cuerpo = document.getElementById("cuerpo-recepcion");
        if (!banda || !cuerpo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        /*
           Las flores entran creciendo desde chiquitas hasta su tamaño y
           después quedan meciéndose despacio, como si estuvieran vivas.
           El volteo viaja dentro de la animación (el signo de scaleX /
           scaleY) y no en el CSS: GSAP escribe su propio transform, así
           que si lo dejaba en la hoja de estilos se perdería al animar.
        */
        const flores = document.querySelector<HTMLElement>(
            "#recepcion-social .caja-flores",
        );
        if (flores) {
            gsap.fromTo(
                flores,
                { scale: 0.45, x: 70, opacity: 0 },
                {
                    scale: 1,
                    x: 0,
                    opacity: 1,
                    duration: 1.5,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: flores,
                        start: "top 95%",
                        toggleActions: "play none none reset",
                    },
                    onComplete: () => {
                        gsap.to(flores, {
                            rotation: 1.6,
                            duration: 5,
                            repeat: -1,
                            yoyo: true,
                            ease: "sine.inOut",
                        });
                    },
                },
            );
        }

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // La ilustración, los renglones y el botón entran uno detrás de otro
        gsap.fromTo(
            [
                cuerpo.querySelector(".ilustracion"),
                ...cuerpo.querySelectorAll(".linea"),
                cuerpo.querySelector(".boton"),
            ].filter(Boolean),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: cuerpo,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
