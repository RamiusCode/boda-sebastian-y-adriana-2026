---
// src/components/RecepcionSocial.astro
// Hermana de CeremoniaReligiosa: franja de papel crema rasgada con el
// "Recepción Social", y debajo la ilustración del salón, el texto y el
// botón del mapa. Las flores entran por la esquina de arriba a la derecha.
//
//
// Medidas del diseño, en % del ancho de la columna:
//   banda            20.5% de alto
//   flores           30% de ancho
//   ilustración      16.4% de ancho
//   botón            32.7% de ancho

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Recepción Social";

const lineas = [
    "Pasada la ceremonia religiosa, los",
    "esperamos en la recepción social",
    "a realizarse en el salón Los Duendes",
    "Camino al Valle de Ananta # 777 a",
    "300 metros del peaje de lipari",
];

/*
   La acuarela del salón, arriba de la dirección. Si se deja vacía, el
   hueco directamente no se dibuja.
*/
const ilustracion = "/imagenes/recepcion.png";

const textoBoton = "Ubicación";
// Búsqueda en Google Maps por la dirección. Si tenés el enlace corto del
// lugar (maps.app.goo.gl/...), pegalo acá y listo.
const mapa =
    "https://maps.app.goo.gl/ZhNBh36z4weoY8Ld7";
// ──────────────────────────────────────────────────────────────
---

<section id="recepcion-social" class="seccion">
    <div class="marco-banda">
        <!--
           Flores entrando por la esquina de arriba a la derecha. Van
           adentro de una caja: la caja es la que se anima y la imagen se
           queda con su volteo, sin que uno pise al otro.
        -->
        <span class="caja-flores" aria-hidden="true">
            <img
                src="/imagenes/florlateral.png"
                alt=""
                width="440"
                height="482"
                class="flores"
            />
        </span>

        <div id="banda-recepcion" class="banda">
            <h2 class="titulo font-elegant">{titulo}</h2>
        </div>
    </div>

    <div id="cuerpo-recepcion" class="cuerpo">
        {
            ilustracion && (
                <img
                    src={ilustracion}
                    alt=""
                    aria-hidden="true"
                    class="ilustracion"
                />
            )
        }

        <div class="direccion">
            {lineas.map((linea) => <p class="linea font-freestyle">{linea}</p>)}
        </div>

        <a
            class="boton font-cormorant"
            href={mapa}
            target="_blank"
            rel="noopener noreferrer"
        >
            {textoBoton}
        </a>

    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 3.5rem;
    }

    /* Sin recorte propio: las flores tienen que pisar la banda */
    .marco-banda {
        position: relative;
        width: 100%;
    }

    /*
       La caja lleva la posición y es la que anima GSAP; la imagen guarda
       el volteo. Separadas a propósito: si la animación tocara la misma
       imagen que lleva los scale en -1, GSAP leería esos menos como media
       vuelta y el ramo giraría como un trompo al entrar.
    */
    .caja-flores {
        position: absolute;
        pointer-events: none;
        filter: drop-shadow(0 6px 10px rgba(90, 70, 20, 0.18));
    }

    .flores {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
    }

    /*
       Las mismas medidas que en el Contador, pero de este lado: volteada
       en vertical para que los tulipanes miren hacia arriba, y espejada en
       horizontal para que el ramo se abra hacia afuera.
    */
    .caja-flores {
        top: -3.5rem;
        right: -1.5rem;
        width: 30%;
        z-index: 2;
    }

    /* El volteo vive acá, en la imagen, y no en la caja que se anima */
    .flores {
        transform: scaleY(-1) scaleX(-1);
    }


    /*
       La banda de papel: el mismo rasgado del modelo, con el trazo corrido
       (13 arriba y 33 abajo) para que no repita el de las otras franjas.
    */
