            12.73% 95.85%,
            10.91% 91.50%,
            9.09% 94.36%,
            7.27% 95.05%,
            5.45% 94.00%,
            3.64% 96.16%,
            1.82% 94.21%,
            0.00% 93.35%
        );
    }

    /* Mismo tamaño y color que los otros títulos de la invitación */
    .titulo {
        margin: 0 auto;
        text-align: center;
        color: #643e1a;
        font-size: clamp(1.8rem, 8.2vw, 2.25rem);
        line-height: 1.2;
    }

    /* ── El cuerpo ─────────────────────────────────────────── */
    .cuerpo {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.4rem 1rem 0;
    }

    /* La acuarela: 20% del ancho de la columna, como en el diseño */
    .iglesia {
        display: block;
        width: 40%;
        max-width: 13rem;
        height: auto;
        user-select: none;
    }

    .direccion {
        margin-top: 1.6rem;
        text-align: center;
    }

    .linea {
        color: #643e1a;
        font-size: clamp(1.45rem, 6.5vw, 1.75rem);
        line-height: 1.75;
    }

    /* ── El botón del mapa ─────────────────────────────────── */
    .boton {
        display: inline-block;
        margin-top: 1.6rem;
        padding: 0.55rem 2.4rem;
        min-width: 32.6%;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #643e1a;
        background: #fbf5de;
        border-radius: 10px;
        font-size: clamp(1.15rem, 5vw, 1.3rem);
        box-shadow: 0 4px 12px rgba(90, 65, 25, 0.12);
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .boton:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(90, 65, 25, 0.18);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const banda = document.getElementById("banda-religioso");
        const cuerpo = document.getElementById("cuerpo-religioso");
        if (!banda || !cuerpo) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        gsap.fromTo(
            banda.querySelector(".titulo"),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: banda,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            },
        );

        // La iglesia, los renglones y el botón entran uno detrás de otro
        gsap.fromTo(
            [
                cuerpo.querySelector(".iglesia"),
                ...cuerpo.querySelectorAll(".linea"),
                cuerpo.querySelector(".boton"),
            ].filter(Boolean),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.1,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: cuerpo,
                    start: "top 88%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
