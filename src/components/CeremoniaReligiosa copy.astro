---
// src/components/CeremoniaReligiosa.astro
// Franja de papel crema rasgada con el "Religioso" y, debajo, sobre el
// papel de la página: el dibujo de la iglesia, la dirección del templo y
// el botón que abre el mapa.
//
// Medidas del diseño, en % del ancho de la columna:
//   banda    21% de alto
//   iglesia  20% de ancho
//   botón    32.6% de ancho

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Religioso";

const lineas = [
    "Iglesia del Señor de la Exaltación",
    "Av. Héctor Ormachea",
    "N° 167 obrajes",
    "zona sur de La Paz",
    "Hora: 11:00",
];

const textoBoton = "Ubicación";
// Búsqueda en Google Maps por el nombre del templo. Si tenés el enlace
// corto del lugar (maps.app.goo.gl/...), pegalo acá y listo.
const mapa =
    "https://www.google.com/maps/search/?api=1&query=Iglesia+del+Se%C3%B1or+de+la+Exaltaci%C3%B3n+Av.+H%C3%A9ctor+Ormachea+Obrajes+La+Paz";
// ──────────────────────────────────────────────────────────────
---

<section id="ceremonia-religiosa" class="seccion">
    <div id="banda-religioso" class="banda">
        <h2 class="titulo font-elegant">{titulo}</h2>
    </div>

    <div id="cuerpo-religioso" class="cuerpo">
        <!-- La acuarela de la iglesia, tal cual viene -->
        <img
            src="/imagenes/iglesia.png"
            alt=""
            aria-hidden="true"
            width="996"
            height="1064"
            class="iglesia"
        />

        <div class="direccion">
            {lineas.map((linea) => <p class="linea font-freestyle">{linea}</p>)}
        </div>

        <a
            class="boton font-cormorant"
            href={mapa}
            target="_blank"
            rel="noopener noreferrer"
        >
            {textoBoton}
        </a>
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 0 0 3.5rem;
    }

    /*
       La banda de papel: el mismo rasgado del modelo, con el trazo corrido
       (27 arriba y 50 abajo) para que no repita el de las otras franjas.
    */
    .banda {
        position: relative;
        width: 100%;
        background: #f7f3d3;
        padding: 2.6rem 1.8rem 2.8rem;
        clip-path: polygon(
            0.00% 5.07%,
            1.82% 5.17%,
            3.64% 6.42%,
            5.45% 5.33%,
            7.27% 5.17%,
            9.09% 4.87%,
            10.91% 3.99%,
            12.73% 2.21%,
            14.55% 2.09%,
            16.36% 0.51%,
            18.18% 1.63%,
            20.00% 2.75%,
            21.82% 2.97%,
            23.64% 4.20%,
            25.45% 6.82%,
            27.27% 5.66%,
            29.09% 5.36%,
            30.91% 3.60%,
            32.73% 3.56%,
            34.55% 4.10%,
            36.36% 3.27%,
            38.18% 2.37%,
            40.00% 4.14%,
            41.82% 6.65%,
            43.64% 5.79%,
            45.45% 3.84%,
            47.27% 6.00%,
            49.09% 4.95%,
            50.91% 5.64%,
            52.73% 8.50%,
            54.55% 4.15%,
            56.36% 4.00%,
            58.18% 4.25%,
            60.00% 6.51%,
            61.82% 5.98%,
            63.64% 6.16%,
            65.45% 5.56%,
            67.27% 4.89%,
            69.09% 6.00%,
            70.91% 6.46%,
            72.73% 6.49%,
            74.55% 6.36%,
            76.36% 4.33%,
            78.18% 7.05%,
            80.00% 5.69%,
            81.82% 3.71%,
            83.64% 2.14%,
            85.45% 1.75%,
            87.27% 2.50%,
            89.09% 3.40%,
            90.91% 5.33%,
            92.73% 4.30%,
            94.55% 5.93%,
            96.36% 6.47%,
            98.18% 6.21%,
            100.00% 4.14%,
            100.00% 95.86%,
            98.18% 97.63%,
            96.36% 96.73%,
            94.55% 95.90%,
            92.73% 96.44%,
            90.91% 96.40%,
            89.09% 94.64%,
            87.27% 94.34%,
            85.45% 93.18%,
            83.64% 95.80%,
            81.82% 97.03%,
            80.00% 97.25%,
            78.18% 98.37%,
            76.36% 99.49%,
            74.55% 97.91%,
            72.73% 97.79%,
            70.91% 96.01%,
            69.09% 95.13%,
            67.27% 94.83%,
            65.45% 94.67%,
            63.64% 93.58%,
            61.82% 94.83%,
            60.00% 94.93%,
            58.18% 95.86%,
            56.36% 93.79%,
            54.55% 93.53%,
            52.73% 94.07%,
            50.91% 95.70%,
            49.09% 94.67%,
            47.27% 96.60%,
            45.45% 97.50%,
            43.64% 98.25%,
            41.82% 97.86%,
            40.00% 96.29%,
            38.18% 94.31%,
            36.36% 92.95%,
            34.55% 95.67%,
            32.73% 93.64%,
            30.91% 93.51%,
            29.09% 93.54%,
            27.27% 94.00%,
            25.45% 95.11%,
            23.64% 94.44%,
            21.82% 93.84%,
            20.00% 94.02%,
            18.18% 93.49%,
            16.36% 95.75%,
